   Reference template — never navigated to in play.
   Copy this pattern for every COMBAT section from the RP log.
   ═══════════════════════════════════════════════════════════ */

:: CombatGuide [guide]
The enemy description goes here.

<<if $str gte 2>>
  <<link "Meet them head-on — strength will carry you.">>
    <<audio "sfx_click" play>>
    <<skillcheck $str 13 "Fight_Win_Brute" "Fight_Lose_Brute">>
  <</link>>
<</if>>

<<if $agi gte 2>>
  <<link "Wait for an opening, then strike fast.">>
    <<audio "sfx_click" play>>
    <<skillcheck $agi 12 "Fight_Win_Agile" "Fight_Lose_Agile">>
  <</link>>
<</if>>

<<if $wis gte 3>>
  <<link "Read their stance. You know this type of fighter.">>
    <<audio "sfx_click" play>>
    <<skillcheck $wis 11 "Fight_Win_Tactical" "Fight_Lose_Tactical">>
  <</link>>
<</if>>

<<if $chr gte 3>>
  <<link "\"Walk away. You don't have to do this.\"">>
    <<audio "sfx_click" play>>
    <<skillcheck $chr 12 "Fight_Win_Persuade" "Fight_Lose_Persuade">>
  <</link>>
<</if>>

<<if $inventory.includes("Flask of Oil")>>
  <<link "Hurl the oil flask. Create distance.">>
    <<audio "sfx_click" play>>
    <<skillcheck $agi 10 "Fight_Win_Item" "Fight_Lose_Item">>
  <</link>>
<</if>>

<<if $hp lte 4>>
  <<link "You're barely standing. Make this count.">>
    <<audio "sfx_click" play>>
    <<skillcheck $str 15 "Fight_Win_Desperate" "Fight_Lose_Desperate">>
  <</link>>
<</if>>

<<link "Run. You're not dying here.">>
  <<audio "sfx_click" play>>
  <<skillcheck $agi 11 "Fight_Flee_Success" "Fight_Flee_Caught">>
<</link>>

/* Lose passages use: <<takedamage 3 "Fight_Aftermath">>
   which subtracts HP and auto-routes to Death if HP hits 0. */
